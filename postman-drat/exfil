#!/usr/bin/env bash

# exfil - Universal document extractor for CLI
# Usage:
#   exfil <file>          - Extract text from a file
#   exfil -r <dir>        - Recursively extract from all files in directory
#   exfil -g <pattern>    - Grep for pattern in all extracted content
#   exfil -g <p> -r <dir> - Grep pattern recursively
#   exfil --pst <file>    - Extract PST only (uses pst-export/pffexport)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# --- PST extraction, via pst-export (which itself wraps pffexport) ---
# pffexport writes an export tree to disk; it does not print message content
# to stdout. pst-export does the export into a scratch directory, and this
# prints the resulting message text so it behaves like every other
# extract_* function here (stdout, greppable).
extract_pst() {
    local file="$1"
    local pst_export_bin=""

    if [[ -x "$SCRIPT_DIR/pst-export" ]]; then
        pst_export_bin="$SCRIPT_DIR/pst-export"
    elif command -v pst-export &>/dev/null; then
        pst_export_bin="pst-export"
    else
        echo "[WARNING] PST support requires pst-export (bundled alongside exfil) or pffexport (libpff)" >&2
        return 1
    fi

    local tmp_out
    tmp_out=$(mktemp -d)

    if ! "$pst_export_bin" "$file" "$tmp_out" >&2; then
        rm -rf "$tmp_out"
        return 1
    fi

    find "$tmp_out/emails" -type f \( -name 'OutlookHeaders.txt' -o -name 'Message.txt' \) 2>/dev/null | sort |
        while IFS= read -r part; do
            echo "--- $(dirname "${part#"$tmp_out"/emails/}") ---"
            cat "$part"
            echo ""
        done

    rm -rf "$tmp_out"
}

# --- PDF extraction ---
extract_pdf() {
    pdftotext -layout "$1" -
}

# --- DOC/DOCX extraction ---
extract_docx() {
    # Try pandoc first (faster, no Python deps)
    if command -v pandoc &>/dev/null; then
        pandoc --from=docx --to=plain "$1" 2>/dev/null && return 0
    fi
    # Fallback to python-docx
    python3 -c "
from docx import Document
import sys
doc = Document('$1')
for para in doc.paragraphs:
    print(para.text)
" 2>/dev/null || echo "[ERROR] Could not extract DOCX" >&2
}

# --- Excel extraction ---
extract_xlsx() {
    python3 -c "
import openpyxl
wb = openpyxl.load_workbook('$1', data_only=True)
for sheet_name in wb.sheetnames:
    print(f'--- SHEET: {sheet_name} ---')
    ws = wb[sheet_name]
    for row in ws.iter_rows(values_only=True):
        print(' | '.join(str(cell) if cell else '' for cell in row))
" 2>/dev/null || echo "[ERROR] Could not extract XLSX" >&2
}

extract_csv() {
    cat "$1"
}

# --- PowerPoint extraction ---
extract_pptx() {
    python3 -c "
from pptx import Presentation
import sys
prs = Presentation('$1')
for slide in prs.slides:
    print('--- SLIDE ---')
    for shape in slide.shapes:
        if hasattr(shape, 'text'):
            print(shape.text)
" 2>/dev/null || echo "[ERROR] Could not extract PPTX" >&2
}

# --- Plain text ---
extract_txt() {
    cat "$1"
}

# --- Generic fallback ---
extract_generic() {
    local ext
    ext=$(get_ext "$1")
    case "$ext" in
        txt|md|log|cfg|json|xml|yaml|yml|toml|csv)
            cat "$1"
            ;;
        *)
            echo "[INFO] Unknown format, trying to read as text..." >&2
            cat "$1" 2>/dev/null || echo "[ERROR] Could not read file" >&2
            ;;
    esac
}

# Get file extension (lowercase)
get_ext() {
    echo "${1##*.}" | tr '[:upper:]' '[:lower:]'
}

# Main dispatcher
extract_file() {
    local file="$1"
    local ext
    ext=$(get_ext "$file")

    case "$ext" in
        pst|ost|pab)       extract_pst "$file" || true ;;
        pdf)               extract_pdf "$file" ;;
        doc|docx|odt|rtf)  extract_docx "$file" ;;
        xls|xlsx|ods)      extract_xlsx "$file" ;;
        ppt|pptx|odp)      extract_pptx "$file" ;;
        txt|md|log|cfg|json|xml|yaml|yml|toml|csv)  extract_txt "$file" ;;
        *)                 extract_generic "$file" ;;
    esac
}

# --- Help ---
usage() {
    cat <<EOF
exfil - Universal document extractor for CLI

Usage:
  exfil <file>           Extract text from a file
  exfil <file1> <file2>  Extract text from multiple files
  exfil -r <dir>         Recursively extract from all files
  exfil -g <pattern>     Grep for pattern (single file)
  exfil -g <p> -r <dir>  Grep pattern recursively
  exfil --pst <file>     Extract PST only (uses pst-export/pffexport)

Examples:
  exfil document.docx               # Extract text from DOCX
  exfil report.pdf -g "error"       # Grep PDF for "error"
  exfil -r ./mail_dump/             # Extract all files recursively
  exfil -g "invoice" -r ./docs/     # Grep all docs for "invoice"
  exfil file1.pst file2.pst         # Extract multiple PSTs (if libpff installed)

Supported formats:
  PST/OST/PAB (Outlook) - requires libpff (nix develop, or system package)
  PDF (via pdftotext)
  DOCX (via pandoc or python-docx)
  XLSX (via openpyxl)
  PPTX (via python-pptx)
  TXT, MD, LOG, JSON, XML, YAML, CSV, CONFIG

EOF
}

# --- Main entry point ---
main() {
    local recursive=false
    local grep_pattern=""
    local pst_only=false
    local files=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)        usage; exit 0 ;;
            -r)               recursive=true; shift ;;
            -g|--grep)        grep_pattern="$2"; shift 2 ;;
            --pst)            pst_only=true; shift ;;
            *)                files+=("$1"); shift ;;
        esac
    done

    if [[ ${#files[@]} -eq 0 ]]; then
        usage
        exit 1
    fi

    # PST-only mode
    if $pst_only; then
        for file in "${files[@]}"; do
            echo "=== PST: $file ==="
            extract_pst "$file" || true
        done
        return 0
    fi

    # Grep mode
    if [[ -n "$grep_pattern" ]]; then
        for file in "${files[@]}"; do
            if [[ -d "$file" ]]; then
                # Recursive grep
                while IFS= read -r f; do
                    ext=$(get_ext "$f")
                    case "$ext" in
                        pst|ost|pab)
                            content=$(extract_pst "$f" 2>/dev/null || true)
                            [[ -n "$content" ]] && echo "=== $f ===" && echo "$content" | grep -i "$grep_pattern" || true
                            ;;
                        pdf)
                            content=$(pdftotext "$f" - 2>/dev/null || true)
                            [[ -n "$content" ]] && echo "=== $f ===" && echo "$content" | grep -i "$grep_pattern" || true
                            ;;
                        txt|md|log|cfg|json|xml|yaml|yml|toml)
                            content=$(cat "$f" 2>/dev/null || true)
                            [[ -n "$content" ]] && echo "=== $f ===" && echo "$content" | grep -i "$grep_pattern" || true
                            ;;
                        docx)
                            content=$(extract_docx "$f" 2>/dev/null || true)
                            [[ -n "$content" ]] && echo "=== $f ===" && echo "$content" | grep -i "$grep_pattern" || true
                            ;;
                        xlsx)
                            content=$(extract_xlsx "$f" 2>/dev/null || true)
                            [[ -n "$content" ]] && echo "=== $f ===" && echo "$content" | grep -i "$grep_pattern" || true
                            ;;
                        pptx)
                            content=$(extract_pptx "$f" 2>/dev/null || true)
                            [[ -n "$content" ]] && echo "=== $f ===" && echo "$content" | grep -i "$grep_pattern" || true
                            ;;
                    esac
                done < <(find "$file" -type f \( -name "*.pst" -o -name "*.ost" -o -name "*.pab" -o -name "*.pdf" -o -name "*.doc" -o -name "*.docx" -o -name "*.xls" -o -name "*.xlsx" -o -name "*.ppt" -o -name "*.pptx" -o -name "*.txt" -o -name "*.md" -o -name "*.log" \))
            else
                echo "=== $file ==="
                extract_file "$file" | grep -i "$grep_pattern" || true
            fi
        done
        return 0
    fi

    # Normal extraction mode
    for file in "${files[@]}"; do
        if [[ -d "$file" ]]; then
            while IFS= read -r f; do
                echo "=== $f ==="
                extract_file "$f"
            done < <(find "$file" -type f \( -name "*.pst" -o -name "*.ost" -o -name "*.pab" -o -name "*.pdf" -o -name "*.doc" -o -name "*.docx" -o -name "*.xls" -o -name "*.xlsx" -o -name "*.ppt" -o -name "*.pptx" -o -name "*.txt" -o -name "*.md" -o -name "*.log" \))
        else
            echo "=== $file ==="
            extract_file "$file"
        fi
    done
}

main "$@"
