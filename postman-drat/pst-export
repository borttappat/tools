#!/usr/bin/env bash

# pst-export - Export PST files to structured directory format
# Usage: pst-export <pst_file> [output_dir]
#
# Delegates the actual PST parsing to `pffexport` (from libpff), then
# reorganizes its output into a manifest + type-sorted attachments folder.
# pffexport's own per-item directories (Message00001/, with
# OutlookHeaders.txt, Message.txt/.html/.rtf, Recipients.txt and an
# Attachments/ subdirectory) are preserved as-is under emails/, since that
# content is already correctly parsed; nothing here re-parses PST internals.

set -euo pipefail

OUTPUT_DIR="${2:-./pst-export}"
PST_FILE="${1:-}"

if [[ -z "$PST_FILE" ]] || [[ ! -f "$PST_FILE" ]]; then
    echo "Usage: pst-export <pst_file> [output_dir]" >&2
    echo "Example: pst-export mail.pst ./outbox" >&2
    echo "" >&2
    echo "This tool exports PST/Outlook files with:" >&2
    echo "  - emails/          : pffexport's native per-item export, organized by PST folder" >&2
    echo "  - attachments/     : attachment files, fanned out by type (pdf, docx, xlsx, etc.)" >&2
    echo "  - manifest.txt     : index of exported email items (Subject/From/To/Date)" >&2
    exit 1
fi

if ! command -v pffexport &>/dev/null; then
    echo "Error: pffexport not found (comes from libpff)." >&2
    echo "       Enter the dev shell (nix develop) or run via the flake (nix run)." >&2
    exit 1
fi

mkdir -p "$OUTPUT_DIR/attachments/pdf" "$OUTPUT_DIR/attachments/doc" \
         "$OUTPUT_DIR/attachments/docx" "$OUTPUT_DIR/attachments/xlsx" \
         "$OUTPUT_DIR/attachments/pptx" "$OUTPUT_DIR/attachments/txt" \
         "$OUTPUT_DIR/attachments/other"

WORKDIR=$(mktemp -d)
trap 'rm -rf "$WORKDIR"' EXIT

echo "Exporting PST via pffexport: $PST_FILE"
pffexport -f text -t "$WORKDIR/export" -l "$WORKDIR/pffexport.log" "$PST_FILE"

EXPORT_ROOT="$WORKDIR/export.export"
if [[ ! -d "$EXPORT_ROOT" ]]; then
    echo "Error: pffexport did not produce the expected export directory ($EXPORT_ROOT)." >&2
    echo "       Check $WORKDIR/pffexport.log for details." >&2
    exit 1
fi

rm -rf "$OUTPUT_DIR/emails"
mv "$EXPORT_ROOT" "$OUTPUT_DIR/emails"
cp "$WORKDIR/pffexport.log" "$OUTPUT_DIR/pffexport.log" 2>/dev/null || true

# Fan out attachments by type and build manifest.txt. Parsing is intentionally
# lenient: OutlookHeaders.txt/Recipients.txt are pffexport's own structured
# "Label:<tabs>value" dumps, not something we reconstruct from raw PST data.
export OUTPUT_DIR
python3 << 'PYTHON'
import os
import re
import shutil

OUTPUT_DIR = os.environ['OUTPUT_DIR']
EMAILS_DIR = os.path.join(OUTPUT_DIR, 'emails')
MANIFEST = os.path.join(OUTPUT_DIR, 'manifest.txt')

ATTACHMENT_FOLDERS = {
    'pdf': 'pdf', 'doc': 'doc', 'docx': 'docx', 'xlsx': 'xlsx',
    'pptx': 'pptx', 'txt': 'txt', 'md': 'txt', 'log': 'txt',
}


def read_field(path, label):
    """Pull the first 'Label:<tabs/spaces>value' line from a pffexport dump."""
    if not os.path.isfile(path):
        return ""
    pattern = re.compile(r'^\s*' + re.escape(label) + r'\s*(.*)$')
    with open(path, 'r', encoding='utf-8', errors='ignore') as f:
        for line in f:
            m = pattern.match(line)
            if m:
                return m.group(1).strip()
    return ""


def read_all_fields(path, label):
    if not os.path.isfile(path):
        return []
    pattern = re.compile(r'^\s*' + re.escape(label) + r'\s*(.*)$')
    values = []
    with open(path, 'r', encoding='utf-8', errors='ignore') as f:
        for line in f:
            m = pattern.match(line)
            if m and m.group(1).strip():
                values.append(m.group(1).strip())
    return values


def attachment_type_folder(filename):
    ext = filename.rsplit('.', 1)[-1].lower() if '.' in filename else ''
    return ATTACHMENT_FOLDERS.get(ext, 'other')


email_count = 0
attachment_count = 0

manifest_lines = [
    "PST Export Manifest",
    "===================",
    f"Emails directory: {EMAILS_DIR}",
    "",
]

for root, dirs, files in os.walk(EMAILS_DIR):
    if 'OutlookHeaders.txt' not in files:
        continue

    headers_path = os.path.join(root, 'OutlookHeaders.txt')
    recipients_path = os.path.join(root, 'Recipients.txt')
    rel_path = os.path.relpath(root, EMAILS_DIR)

    subject = read_field(headers_path, 'Subject:') or "No Subject"
    sender_name = read_field(headers_path, 'Sender name:')
    sender_email = read_field(headers_path, 'Sender email address:')
    sent_time = (
        read_field(headers_path, 'Client submit time:')
        or read_field(headers_path, 'Delivery time:')
        or read_field(headers_path, 'Creation time:')
    )
    recipients = read_all_fields(recipients_path, 'Email address:')

    email_count += 1
    manifest_lines.append(f"[EMAIL] {rel_path}")
    manifest_lines.append(f"  Subject: {subject}")
    if sender_name or sender_email:
        manifest_lines.append(f"  From: {sender_name} <{sender_email}>".replace(" <>", ""))
    if recipients:
        manifest_lines.append(f"  To: {', '.join(recipients)}")
    if sent_time:
        manifest_lines.append(f"  Date: {sent_time}")

    attachments_dir = os.path.join(root, 'Attachments')
    if os.path.isdir(attachments_dir):
        msg_base = os.path.basename(root)
        for att_name in sorted(os.listdir(attachments_dir)):
            att_path = os.path.join(attachments_dir, att_name)
            if not os.path.isfile(att_path):
                continue
            folder = attachment_type_folder(att_name)
            safe_name = f"{msg_base}__{att_name}"
            dest = os.path.join(OUTPUT_DIR, 'attachments', folder, safe_name)
            shutil.copy2(att_path, dest)
            attachment_count += 1
            manifest_lines.append(f"  [ATTACH] {folder}/{safe_name}")

manifest_lines.append("")
manifest_lines.append("===================")
manifest_lines.append(f"Total emails: {email_count}")
manifest_lines.append(f"Total attachments: {attachment_count}")

with open(MANIFEST, 'w', encoding='utf-8') as f:
    f.write("\n".join(manifest_lines) + "\n")

print(f"\nExport complete.")
print(f"  Emails: {email_count}")
print(f"  Attachments: {attachment_count}")
print(f"  Output directory: {OUTPUT_DIR}")
PYTHON
